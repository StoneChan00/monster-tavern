# Firebase 云同步配置（复制为 .env.local 后填入自己的项目值）
#
# 取值位置：Firebase 控制台 → 项目设置 → 你的应用 → SDK 设置和配置 → 配置
# 全部是公开信息（前端可见），真正的访问控制在 Realtime Database 安全规则里。
#
# 不填这些变量时，游戏自动退化为纯本地版本：不显示登录入口，存档只在浏览器。

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
