# 生产构建用的 Firebase 配置（GitHub Pages 构建时读取）
#
# 这几个值全部是公开信息：它们会原样打包进前端 JS，任何人打开 DevTools 都能看到。
# 真正的访问控制在 Realtime Database 安全规则里（见 docs/cloud-save.md），
# 因此放在仓库里是安全且方便的——不需要在 CI 里配置 secrets。
#
# 本地开发用 .env.local（已 gitignore），两边取值应保持一致。
# 若要改用 CI secrets：删掉本文件，或注意 process.env 优先级高于 .env 文件。

VITE_FIREBASE_API_KEY=AIzaSyBClSbUwOwCEEuyTbgG4AkBmH0mo4CqPqc
VITE_FIREBASE_AUTH_DOMAIN=monster-tavern.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://monster-tavern-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=monster-tavern
VITE_FIREBASE_APP_ID=1:14318049323:web:c4d69aa3e988962841f26e
